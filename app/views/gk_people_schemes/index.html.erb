<% html_title l(:label_gk_people_schemes) %>
<% content_for :header_tags do %><%= stylesheet_link_tag 'gk_people', plugin: 'gk_people' %><% end %>
<div class="contextual">
  <%= link_to sprite_icon('add', l(:label_gk_people_scheme_new)), new_gk_people_scheme_path, class: 'icon icon-add' %>
</div>
<h2><%= l(:label_gk_people_schemes) %></h2>
<p class="gk-people-muted"><%= l(:text_gk_people_schemes_intro) %></p>
<% if @schemes.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<table class="list gk-people-list" data-gk-gui-rowmenu>
  <thead><tr><th><%= l(:field_name) %></th><th><%= l(:label_gk_people_key) %></th><th><%= l(:field_type) %></th>
    <th><%= l(:label_gk_people_unique) %></th><th><%= l(:label_gk_people_link_template) %></th><th><%= l(:label_gk_people_in_use) %></th><th><%= l(:field_active) %></th><th></th></tr></thead>
  <tbody>
  <% @schemes.each do |s| %>
    <tr class="<%= cycle('odd', 'even') %><%= ' gk-people-inactive' unless s.active %>">
      <td class="name"><%= link_to s.name, edit_gk_people_scheme_path(s) %></td>
      <td class="key"><code><%= s.key %></code></td>
      <td class="kind"><%= gk_people_scheme_kind_tag(s.kind) %></td>
      <td class="unique"><%= gk_people_yes_no(s.unique_value) %></td>
      <td class="text"><code class="gk-people-template"><%= s.link_template %></code></td>
      <td class="in_use"><%= @in_use[s.id].to_i %></td>
      <td class="active"><%= gk_people_yes_no(s.active) %></td>
      <td class="buttons"><%= link_to sprite_icon('edit', l(:button_edit)), edit_gk_people_scheme_path(s), class: 'icon icon-edit', data: { gk_gui_row_action: 'keep' } %></td>
    </tr>
  <% end %>
  </tbody>
</table>
<% end %>
<%= gk_gui_stuff_row_menu %>
