<%# A responsibility: key (never changed), name, kind, description and the role description as a wiki page %>
<% content_for :header_tags do %><%= stylesheet_link_tag 'gk_people', plugin: 'gk_people' %><% end %>
<%= error_messages_for @responsibility %>
<% r = @responsibility %>
<%= form_tag((r.persisted? ? gk_people_responsibility_path(r) : gk_people_responsibilities_path), method: (r.persisted? ? :patch : :post)) do %>
<div class="box tabular">
  <p><label for="responsibility_key"><%= l(:field_gk_people_key) %> <span class="required">*</span></label>
    <%= text_field_tag 'responsibility[key]', r.key, size: 30, id: 'responsibility_key', data: (r.new_record? ? { gk_gui_stuff_key_from: 'responsibility_name', gk_gui_stuff_key_max: 60, gk_gui_stuff_key_examples: GkPeopleResponsibility.order(:key).limit(3).pluck(:key).join(', ') } : {}), disabled: r.persisted? %>
    <em class="info"><%= l(:text_gk_people_key_never_changes) %></em></p>
  <p><label for="responsibility_name"><%= l(:field_name) %> <span class="required">*</span></label>
    <%= text_field_tag 'responsibility[name]', r.name, size: 50, id: 'responsibility_name' %></p>
  <p><label for="responsibility_kind"><%= l(:field_gk_people_kind) %></label>
    <%= select_tag 'responsibility[kind]', options_for_select(GkPeople::Responsibilities::KINDS.map { |k| [l("label_gk_people_resp_kind_#{k}"), k] }, r.kind), id: 'responsibility_kind' %>
    <em class="info"><%= l(:text_gk_people_resp_kinds) %></em></p>
  <p><label for="responsibility_description"><%= l(:field_description) %></label>
    <%= text_area_tag 'responsibility[description]', r.description, rows: 4, cols: 60, id: 'responsibility_description', class: 'wiki-edit' %></p>
  <p><label for="responsibility_wiki_page_id"><%= l(:label_gk_people_role_description) %></label>
    <%= select_tag 'responsibility[wiki_page_id]', options_for_select([['', '']] + WikiPage.joins(wiki: :project).merge(Project.visible).includes(wiki: :project).order('projects.name', :title).limit(500).map { |w| ["#{w.project.name}: #{w.pretty_title}", w.id] }, r.wiki_page_id), id: 'responsibility_wiki_page_id' %>
    <em class="info"><%= l(:text_gk_people_role_description) %></em></p>
  <% if GkPeople::Credentials.ready? && GkPeople.feature?('people.credentials') && (kinds = GkPeopleCredentialKind.active.for_holder('person').sorted.to_a).any? %>
    <% req = GkPeople::Credentials.required_keys(r) %>
    <p><label><%= l(:label_gk_people_required_credentials) %></label>
      <%= hidden_field_tag 'responsibility[required_credential_keys][]', '', id: nil %>
      <% kinds.each do |k| %>
        <label class="inline"><%= check_box_tag 'responsibility[required_credential_keys][]', k.key, req.include?(k.key), id: "responsibility_required_#{k.key}" %> <%= k.name %></label>
      <% end %>
      <em class="info"><%= l(:text_gk_people_required_credentials) %></em></p>
  <% end %>
  <% if GkPeople::RoleSync.ready? && User.current.admin? %>
    <p><label for="responsibility_role_sync"><%= l(:label_gk_people_role_sync_here) %></label>
      <%= hidden_field_tag 'responsibility[role_sync]', '0', id: nil %><%= check_box_tag 'responsibility[role_sync]', '1', r.role_sync, id: 'responsibility_role_sync' %>
      <em class="info"><%= l(:text_gk_people_role_sync_here) %></em></p>
  <% end %>
  <p><label for="responsibility_position"><%= l(:field_gk_people_position) %></label>
    <%= number_field_tag 'responsibility[position]', r.position, id: 'responsibility_position', class: 'gk-people-num' %></p>
  <p><label for="responsibility_active"><%= l(:field_active) %></label>
    <%= hidden_field_tag 'responsibility[active]', '0', id: nil %><%= check_box_tag 'responsibility[active]', '1', r.active, id: 'responsibility_active' %></p>
</div>
<p><%= submit_tag(r.persisted? ? l(:button_save) : l(:button_create)) %>
  <%= link_to l(:button_cancel), (r.persisted? ? gk_people_responsibility_path(r) : gk_people_responsibilities_path) %></p>
<% end %>
