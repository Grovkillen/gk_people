<%# Administration, Organisationstyper: the kinds of organization and how many organizations have each %>
<% html_title l(:label_gk_people_org_kinds) %>
<% content_for :header_tags do %><%= stylesheet_link_tag 'gk_people', plugin: 'gk_people' %><% end %>
<div class="contextual">
  <%= link_to sprite_icon('add', l(:label_gk_people_org_kind_new)), new_gk_people_org_kind_path, class: 'icon icon-add' %>
</div>
<h2><%= l(:label_gk_people_org_kinds) %></h2>
<p class="gk-people-muted"><%= l(:text_gk_people_org_kinds_intro) %></p>
<% if @kinds.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<table class="list gk-people-list" data-gk-gui-rowmenu>
  <thead><tr><th><%= l(:field_name) %></th><th><%= l(:label_gk_people_key) %></th><th><%= l(:label_gk_people_in_use) %></th><th><%= l(:field_active) %></th><th></th></tr></thead>
  <tbody>
  <% @kinds.each do |k| %>
    <tr class="<%= cycle('odd', 'even') %><%= ' gk-people-inactive' unless k.active %>">
      <td class="name"><%= link_to k.name, edit_gk_people_org_kind_path(k) %></td>
      <td class="key"><code><%= k.key %></code></td>
      <td class="in_use"><%= link_to @in_use[k.id].to_i, gk_people_organizations_path(kind: k.key, active: 'all') %></td>
      <td class="active"><%= gk_people_yes_no(k.active) %></td>
      <td class="buttons"><%= link_to sprite_icon('edit', l(:button_edit)), edit_gk_people_org_kind_path(k), class: 'icon icon-edit', data: { gk_gui_row_action: 'keep' } %></td>
    </tr>
  <% end %>
  </tbody>
</table>
<% end %>
<%= gk_gui_stuff_row_menu %>
