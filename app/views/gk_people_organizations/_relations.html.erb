<% rels = org.visible_relations %>
<% manage = GkPeople::Access.manage? %>
<h3 id="gk-people-relations"><%= l(:label_gk_people_relations) %></h3>
<%# Ny relation sits in the box above the list, minimized, open when there is none %>
<% if manage %>
<% new_box = capture do %>
  <%= form_tag gk_people_relations_path(org), class: 'gk-people-inline-form' do %>
    <label><%= l(:label_gk_people_relation_kind) %> <%= select_tag 'kind', options_for_select(GkPeopleOrgKind.active.sorted.map { |k| [k.name, k.key] }) %></label>
    <label><%= l(:label_project) %> <%= select_tag 'project_id', content_tag('option', l(:label_gk_people_relation_global), value: '') + options_from_collection_for_select(Project.visible.active.sorted, :id, :name) %></label>
    <label><%= l(:label_gk_people_valid_from) %> <%= date_field_tag 'valid_from', User.current.today %></label>
    <label><%= l(:label_gk_people_valid_to) %> <%= date_field_tag 'valid_to', '' %></label>
    <%# Lägg till is GK GUI Stuff's button with a reason, the place people.relation_new; its buttons belong to this form %>
    <%= gk_gui_stuff_reason_button(l(:button_add), reason: GkPeople.reason('relation_new')) %>
  <% end %>
<% end %>
<% box_title = l(:label_gk_people_relation_new) %>
<%= gk_gui_stuff_choices_box('people.relation_new', box_title, open: rels.empty?) { new_box } %>
<% end %>
<% if rels.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<table class="list gk-people-list" data-gk-gui-rowmenu>
  <thead><tr><th><%= l(:label_gk_people_relation_kind) %></th><th><%= l(:label_project) %></th><th><%= l(:label_gk_people_valid_from) %></th>
    <th><%= l(:label_gk_people_valid_to) %></th><th><%= l(:label_gk_people_reason) %></th><th><%= l(:field_status) %></th><% if manage %><th></th><% end %></tr></thead>
  <tbody>
  <% rels.each do |r| %>
    <% st = r.state %>
    <tr class="<%= cycle('odd', 'even') %><%= ' gk-people-inactive' unless st == :current %>">
      <td class="name"><span class="gk-people-org-kind gk-people-org-kind-<%= r.kind.key %>"><%= r.kind.name %></span></td>
      <td class="project"><%= r.project ? link_to_project(r.project) : l(:label_gk_people_relation_global) %></td>
      <td class="valid_from"><%= r.valid_from ? format_date(r.valid_from) : '' %></td>
      <td class="valid_to"><%= r.valid_to ? format_date(r.valid_to) : '' %></td>
      <td class="description"><%= r.reason %></td>
      <td class="status"><span class="badge <%= { current: 'badge-status-closed', future: 'badge-status-open' }.fetch(st, 'badge-status-locked') %> gk-people-relation-state gk-people-relation-state-<%= st %>"><%= l("label_gk_people_relation_#{st}") %></span></td>
      <% if manage %>
        <td class="buttons"><% if st != :ended %>
          <%= form_tag gk_people_relation_end_path(org, r.id), method: :patch, class: 'gk-people-inline-form', data: { gk_gui_row_action: 'keep' } do %>
            <%= date_field_tag 'valid_to', User.current.today, id: nil %>
            <%# Avsluta is GK GUI Stuff's button with a reason, the place people.relation_end; it sends this row's day %>
            <%= gk_gui_stuff_reason_button(l(:button_gk_people_relation_end), reason: GkPeople.reason('relation_end')) %>
          <% end %>
        <% end %></td>
      <% end %>
    </tr>
  <% end %>
  </tbody>
</table>
<% end %>
<%= gk_gui_stuff_row_menu %>
