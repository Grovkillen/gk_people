<% list = person.consents.includes(:project).to_a %>
<% manage = GkPeople::Access.manage? %>
<% if list.any? || manage %>
<%# A box of its own with the heading inside, in the person's column %>
<div class="box gk-people-section">
<h3 id="gk-people-consents"><%= l(:label_gk_people_consents) %></h3>
<%# Nytt samtycke sits in the box above the list, minimized, open when there is none %>
<% if manage %>
<% new_box = capture do %>
  <%= form_tag gk_people_consents_path(person), class: 'gk-people-inline-form' do %>
    <label><%= l(:label_gk_people_consent_purpose) %> <%= text_field_tag 'purpose', '', size: 30, maxlength: 200, required: true %></label>
    <label><%= l(:label_project) %> <%= select_tag 'project_id', content_tag('option', '', value: '') + options_from_collection_for_select(Project.visible.active.sorted, :id, :name) %></label>
    <label><%= l(:label_gk_people_consent_given) %> <%= date_field_tag 'given_on', User.current.today %></label>
    <label><%= l(:label_gk_people_valid_to) %> <%= date_field_tag 'valid_to', '' %></label>
    <%= submit_tag l(:button_add) %>
  <% end %>
<% end %>
<% box_title = l(:label_gk_people_consent_new) %>
<%= gk_gui_stuff_choices_box('people.consent_new', box_title, open: list.empty?) { new_box } %>
<% end %>
<% if list.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<table class="list gk-people-list" data-gk-gui-rowmenu>
  <thead><tr><th><%= l(:label_gk_people_consent_purpose) %></th><th><%= l(:label_project) %></th><th><%= l(:label_gk_people_consent_given) %></th>
    <th><%= l(:label_gk_people_valid_to) %></th><th><%= l(:field_status) %></th><% if manage %><th></th><% end %></tr></thead>
  <tbody>
  <% list.each do |c| %>
    <% st = c.state %>
    <tr class="<%= cycle('odd', 'even') %><%= ' gk-people-inactive' unless st == :current %>">
      <td class="name"><%= c.purpose %></td>
      <td class="project"><%= c.project ? link_to_project(c.project) : '' %></td>
      <td class="given_on"><%= format_date(c.given_on) %></td>
      <td class="valid_to"><%= c.valid_to ? format_date(c.valid_to) : '' %></td>
      <td class="status"><span class="badge <%= { current: 'badge-status-closed', future: 'badge-status-open', revoked: 'badge-private' }.fetch(st, 'badge-status-locked') %> gk-people-consent gk-people-consent-<%= st %>"><%= l("label_gk_people_consent_#{st}") %></span>
        <% if c.revoked_on %><span class="gk-people-muted"><%= format_date(c.revoked_on) %><%= ": #{c.revoke_reason}" if c.revoke_reason.present? %></span><% end %></td>
      <% if manage %>
        <td class="buttons"><% unless c.revoked_on %>
          <%= form_tag gk_people_consent_revoke_path(person, c.id), method: :patch, class: 'gk-people-inline-form', data: { gk_gui_row_action: 'keep' } do %>
            <%= date_field_tag 'revoked_on', User.current.today, id: nil %>
            <%# Återkalla is GK GUI Stuff's button with a reason, the place people.consent_revoke; it sends this row's day %>
            <%= gk_gui_stuff_reason_button(l(:button_gk_people_consent_revoke), reason: GkPeople.reason('consent_revoke')) %>
          <% end %>
        <% end %></td>
      <% end %>
    </tr>
  <% end %>
  </tbody>
</table>
<% end %>
</div>
<%= gk_gui_stuff_row_menu %>
<% end %>
