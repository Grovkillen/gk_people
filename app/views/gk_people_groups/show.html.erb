<% html_title @group.name %>
<% content_for :header_tags do %><%= stylesheet_link_tag 'gk_people', plugin: 'gk_people' %><% end %>
<% manage = GkPeople::Access.manage? %>
<% members_here = manage && !@group.owned_by_source?(:members) %>
<div class="contextual">
  <% if manage %><%= link_to sprite_icon('edit', l(:button_edit)), edit_gk_people_group_path(@group), class: 'icon icon-edit' %><% end %>
</div>
<h2><%= link_to l(:label_gk_people_groups), gk_people_groups_path %> &#187; <%= @group.name %>
  <% unless @group.active %><span class="badge badge-status-locked gk-people-badge"><%= l(:label_gk_people_inactive) %></span><% end %></h2>

<div class="splitcontent">
<div class="splitcontentleft">
  <% if @group.description.present? %><div class="box wiki"><%= simple_format(h(@group.description)) %></div><% end %>
  <% if @group.synced? %><p class="gk-people-muted"><%= l(:label_gk_people_source) %>: <%= @group.source %> <%= @group.external_id %></p><% end %>

  <%# Lägg till medlem sits in the box above Medlemmar, minimized, open when the group has no members or a search is
      under way %>
  <% if members_here && @group.active %>
    <% member_box = capture do %>
      <%= form_tag gk_people_group_path(@group), method: :get, class: 'gk-people-inline-form' do %>
        <%= text_field_tag 'q', @q, size: 30, placeholder: l(:text_gk_people_search_persons), id: 'gk-people-member-q' %>
        <%= submit_tag l(:label_search), name: nil %>
      <% end %>
      <% if @found %>
        <% if @found.empty? %>
          <p class="nodata"><%= l(:label_no_data) %></p>
        <% else %>
        <table class="list gk-people-found" data-gk-gui-rowmenu>
          <tbody>
          <% @found.each do |p| %>
            <tr><td class="name"><%= gk_people_person_link(p) %></td><td class="organization"><%= p.organization&.name %></td>
              <td class="buttons"><%= form_tag add_member_gk_people_group_path(@group), class: 'gk-people-inline', data: { gk_gui_row_action: 'keep' } do %>
                <%= hidden_field_tag 'person_id', p.id, id: nil %><%= submit_tag l(:button_add), name: nil %>
              <% end %></td></tr>
          <% end %>
          </tbody>
        </table>
        <% end %>
      <% end %>
    <% end %>
    <% box_title = l(:label_gk_people_add_member) %>
    <%= gk_gui_stuff_choices_box('people.member_add', box_title, open: @members.empty? || @q.present?) { member_box } %>
  <% end %>
  <h3 id="gk-people-members"><%= l(:label_gk_people_members) %> <%= gk_gui_stuff_count(@members.size) %></h3>
  <% if @members.empty? %>
    <p class="nodata"><%= l(:label_no_data) %></p>
  <% else %>
  <table class="list gk-people-members" data-gk-gui-rowmenu>
    <thead><tr><th><%= l(:label_gk_people_person) %></th><th><%= l(:label_gk_people_organization) %></th><th><%= l(:label_gk_people_title) %></th><th><%= l(:label_gk_people_account) %></th><th></th></tr></thead>
    <tbody>
    <% @members.each do |m| p = m.person %>
      <tr class="<%= cycle('odd', 'even') %><%= ' gk-people-inactive' unless p.active %>">
        <td class="name"><%= gk_people_person_link(p) %></td>
        <td class="organization"><%= gk_people_org_link(p.organization) %></td>
        <td class="title"><%= p.title %></td>
        <td class="account"><%= p.user_id ? gk_people_yes_no(true) : '' %><%= gk_people_person_mark(p) %></td>
        <td class="buttons"><% if members_here %>
          <%= link_to l(:button_gk_people_remove_member), remove_member_gk_people_group_path(@group, person_id: p.id), method: :post, data: gk_gui_stuff_confirm_data(l(:text_gk_people_remove_member_confirm, name: p.name)).merge(gk_gui_row_action: true) %>
        <% end %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <% end %>
</div>

<div class="splitcontentright">
  <% if @group.owned_by_source?(:members) %>
    <p class="gk-people-muted"><%= l(:error_gk_people_members_by_source) %></p>
  <% end %>
</div>
</div>

<%= gk_gui_stuff_row_menu %>
<%= gk_records_list(@group) if GkPeople.records? %>
